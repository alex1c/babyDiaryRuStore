{
  "expo": {
    "name": "Дневник малыша",
    "slug": "baby-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "babydiary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calculatorplatform.babydiary"
    },
    "android": {
      "package": "com.calculatorplatform.babydiary",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F2"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото, чтобы сохранять моменты малыша.",
          "cameraPermission": "Приложению нужна камера, чтобы снимать моменты малыша."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
