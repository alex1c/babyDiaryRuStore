# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
dist-*/
dist-android-smoke/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS / Windows
.DS_Store
Thumbs.db
*.pem

# local env / secrets
.env
.env.*
!.env.example
*.local
credentials/*
!credentials/.gitkeep
keystore.properties
**/keystore.properties

# release artifacts — ignore signed binaries; keep store icon assets tracked
release-artifacts/*
!release-artifacts/.gitkeep
!release-artifacts/icon-512.png
!release-artifacts/ICON_NOTES.md

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local tooling — never machine-specific paths in repo
/tools/

# test / coverage
coverage/

# IDE
.idea/
.vscode/
*.swp

# local visual smoke artifacts
.tmp-*/
